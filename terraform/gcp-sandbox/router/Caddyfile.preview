# Preview router, previews on your own domain (module input `preview`).
#
#   https://<port>-<sandbox>.<domain>  (TLS ends at the GKE Gateway)
#     -> this router on :8080 -> <sandbox>.sandboxes.svc.cluster.local:<port>
#
# Nothing upstream vouches for the visitor, so the router checks Runtm's
# signed preview token itself, the way Runtm's own preview edge does:
#
#   - The token is a JWT Runtm signs with an asymmetric key (ES256/RS256). The
#     router verifies it against Runtm's published keys (RUNTM_PREVIEW_JWKS_URL),
#     so no secret is shared with your cluster.
#   - `aud` must be this preview domain and `lbl` must equal the host's first
#     label (<port>-<sandbox>): a token minted for one sandbox port opens
#     nothing else.
#   - Without a valid token the visitor is sent to Runtm to sign in
#     (/api/sandbox-proxy/auto-mint). Runtm sends them back to
#     /__runtm/auth?token=<jwt>&return=<path> on the same host, which stores the
#     token in a host-only cookie and redirects to <path>.
#   - A sandbox that is paused or not listening yet (502/503/504 for a page) is
#     sent to Runtm's wake flow, as on Runtm's edge.
#
# Environment (set by the module): RUNTM_PREVIEW_DOMAIN, RUNTM_PREVIEW_DOMAIN_RE
# (the domain with dots escaped), RUNTM_PREVIEW_JWKS_URL, RUNTM_APP_ORIGIN,
# RUNTM_PROXY_CIDRS (the load balancer's proxy-only subnet).
{
	admin off
	auto_https off
	order jwtauth before basicauth
	servers {
		trusted_proxies static {$RUNTM_PROXY_CIDRS}
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	# route{} keeps the written order (Caddy would otherwise sort the handle blocks).
	route {
		# Load balancer health check (HealthCheckPolicy).
		handle /__runtm/healthz {
			respond "ok" 200
		}

		# <port>-<sandbox>.<domain>: the whole first label, the port and the sandbox.
		map {host} {previewLabel} {previewPort} {previewSandbox} {
			~^(([0-9]{1,5})-([a-z0-9]([-a-z0-9]*[a-z0-9])?))\.{$RUNTM_PREVIEW_DOMAIN_RE}$ "${1}" "${2}" "${3}"
			default "" "" ""
		}

		@unknownHost expression `{previewLabel} == ""`
		handle @unknownHost {
			respond "Unknown preview host" 404
		}

		# Runtm hands the visitor back with a fresh token: verify it, keep it in a
		# host-only cookie, go to the page. `return` must be a path on this host.
		handle /__runtm/auth {
			route {
				jwtauth {
					jwk_url {$RUNTM_PREVIEW_JWKS_URL}
					from_query token
					audience_whitelist {$RUNTM_PREVIEW_DOMAIN}
					meta_claims "lbl->lbl"
				}
				@labelMismatch expression `{http.auth.user.lbl} != {previewLabel}`
				error @labelMismatch 401

				@badReturn expression `{query.return} != "" && (!{query.return}.startsWith("/") || {query.return}.startsWith("//") || {query.return}.contains("\\"))`
				respond @badReturn "Bad return path" 400

				# SameSite=None: previews are embedded in Runtm's workspace (another site).
				header Set-Cookie "runtm_preview={query.token}; Path=/; Max-Age=86400; Secure; HttpOnly; SameSite=None"
				header Cache-Control "no-store"
				@noReturn expression `{query.return} == ""`
				redir @noReturn / 302
				redir {query.return} 302
			}
		}

		handle {
			route {
				jwtauth {
					jwk_url {$RUNTM_PREVIEW_JWKS_URL}
					from_cookies runtm_preview
					audience_whitelist {$RUNTM_PREVIEW_DOMAIN}
					meta_claims "lbl->lbl"
				}
				@labelMismatch expression `{http.auth.user.lbl} != {previewLabel}`
				error @labelMismatch 401

				# Only Runtm's workspace may frame a preview (the app's own
				# X-Frame-Options would otherwise block it).
				header {
					-X-Frame-Options
					Content-Security-Policy "frame-ancestors {$RUNTM_APP_ORIGIN}"
				}

				reverse_proxy {previewSandbox}.sandboxes.svc.cluster.local:{previewPort} {
					flush_interval -1
					# Short on purpose: a paused or booting sandbox fails fast into the
					# wake redirect below instead of a blank tab.
					transport http {
						dial_timeout 5s
					}
				}
			}
		}
	}

	handle_errors {
		# In order: Caddy would otherwise run every redir before respond.
		route {
			# A bad handoff token is final: sending it back to sign in would loop.
			@handoffFailed {
				expression {http.error.status_code} == 401
				path /__runtm/auth
			}
			respond @handoffFailed "Invalid preview token" 401

			@authFailed expression {http.error.status_code} == 401
			redir @authFailed {$RUNTM_APP_ORIGIN}/api/sandbox-proxy/auto-mint?return=https://{host}{uri} 302

			@sandboxDown {
				expression `{http.error.status_code} == 502 || {http.error.status_code} == 503 || {http.error.status_code} == 504`
				header Accept *text/html*
			}
			redir @sandboxDown {$RUNTM_APP_ORIGIN}/api/sandbox-proxy/wake?return=https://{host}{uri} 302
		}
	}
}
