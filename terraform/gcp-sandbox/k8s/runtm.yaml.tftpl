# Runtm objects in the sandbox cluster, applied by scripts/cluster-setup.sh
# after the agent-sandbox controller. Rendered by main.tf (templatefile).
#
# agent-sandbox v1.0.9 refuses SandboxClaim labels outside its allow-list
# (default sandbox.users.io). Runtm labels paused pods runtm.com/* and pins
# restores with the podsnapshot.gke.io/ps-name annotation; the controller
# reads this ConfigMap at start, so the setup script restarts it.
apiVersion: v1
kind: ConfigMap
metadata:
  name: agent-sandbox-config
  namespace: agent-sandbox-system
data:
  allowed-label-domains: runtm.com,podsnapshot.gke.io
---
apiVersion: v1
kind: Namespace
metadata:
  name: sandboxes
---
# Where Pod Snapshots are written: gs://<bucket>/podsnapshots/. federatedP4SA
# = the GKE node service agent writes with short-lived, path-scoped tokens;
# code inside a sandbox gets no bucket access.
apiVersion: podsnapshot.gke.io/v1
kind: PodSnapshotStorageConfig
metadata:
  name: runtm-snapshots
spec:
  snapshotStorageConfig:
    gcs:
      bucket: ${bucket}
      path: podsnapshots
      tokenSource: federatedP4SA
---
# Root-filesystem snapshots, taken only when Runtm creates a
# PodSnapshotManualTrigger (at pause), for pods Runtm labelled for it. Grouped
# per session so a restore only ever picks that session's snapshots. The
# workspace archive in fs-snapshots/ is the durable copy; snapshots not
# restored for 90 days are deleted by GKE.
apiVersion: podsnapshot.gke.io/v1
kind: PodSnapshotPolicy
metadata:
  name: runtm-rootfs
  namespace: sandboxes
spec:
  selector:
    matchLabels:
      runtm.com/snapshot: "true"
      runtm.com/snapshot-manual: "true"
  storageConfigName: runtm-snapshots
  snapshotScope: rootfs-only
  triggerConfig:
    type: manual
    postCheckpoint: resume
  snapshotGroupingRules:
    groupByLabelValue:
      labels: ["runtm.com/session-id"]
  retentionConfig:
    lastAccessTimeout: 90d
---
# What Runtm may do in this cluster: run sandboxes in the `sandboxes`
# namespace, and read what it needs to pick and heal snapshots. Bound to your
# organization's Runtm service account only. No cluster-admin, no Secrets.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: runtm-hub
  namespace: sandboxes
rules:
  - apiGroups: [extensions.agents.x-k8s.io]
    resources: [sandboxclaims]
    verbs: [get, list, watch, create, delete, patch]
  - apiGroups: [extensions.agents.x-k8s.io]
    resources: [sandboxtemplates, sandboxwarmpools]
    verbs: [get, create, patch]
  - apiGroups: [agents.x-k8s.io]
    resources: [sandboxes]
    verbs: [get]
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, delete]
  - apiGroups: [""]
    resources: [pods/exec]
    verbs: [create, get]
  - apiGroups: [""]
    resources: [events]
    verbs: [list]
  - apiGroups: [""]
    resources: [services]
    verbs: [get]
  - apiGroups: [podsnapshot.gke.io]
    resources: [podsnapshots]
    verbs: [get, list, delete]
  - apiGroups: [podsnapshot.gke.io]
    resources: [podsnapshotmanualtriggers]
    verbs: [create, get, delete]
  - apiGroups: [podsnapshot.gke.io]
    resources: [podsnapshottokenrequests]
    verbs: [patch, delete]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: runtm-hub
  namespace: sandboxes
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: runtm-hub
subjects:
  - apiGroup: rbac.authorization.k8s.io
    kind: User
    name: ${runtm_sa_email}
---
# Node versions (to match a snapshot to the nodes it can restore on) and the
# snapshot storage config (to check the setup).
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: runtm-hub
rules:
  - apiGroups: [""]
    resources: [nodes]
    verbs: [get, list]
  - apiGroups: [podsnapshot.gke.io]
    resources: [podsnapshotstorageconfigs]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: runtm-hub
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: runtm-hub
subjects:
  - apiGroup: rbac.authorization.k8s.io
    kind: User
    name: ${runtm_sa_email}
---
# Read the agent-sandbox label allow-list above (setup check).
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: runtm-hub
  namespace: agent-sandbox-system
rules:
  - apiGroups: [""]
    resources: [configmaps]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: runtm-hub
  namespace: agent-sandbox-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: runtm-hub
subjects:
  - apiGroup: rbac.authorization.k8s.io
    kind: User
    name: ${runtm_sa_email}
---
%{ if preview == null ~}
# Preview router: Runtm's preview edge -> <sandbox>.sandboxes.svc:<port>.
# See router/Caddyfile. It lives in agent-sandbox-system with label
# app=sandbox-router because that is the one ingress source the NetworkPolicy
# agent-sandbox v1.0.9 manages for each sandbox admits (namespace
# agent-sandbox-system AND that label); from `sandboxes` it is refused.
apiVersion: v1
kind: ConfigMap
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
data:
  Caddyfile: |
    ${indent(4, router_caddyfile)}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
  labels:
    app: sandbox-router
spec:
  replicas: 1
  selector:
    matchLabels:
      app: sandbox-router
  template:
    metadata:
      labels:
        app: sandbox-router
      annotations:
        # Restart the router when its config changes.
        runtm.com/config-sha256: ${router_config_sha256}
        cluster-autoscaler.kubernetes.io/safe-to-evict: "false"
    spec:
      containers:
        - name: caddy
          image: ${router_image}
          ports:
            - { name: http, containerPort: 8080 }
          env:
            # Space-separated; trusted as proxies (router/Caddyfile).
            - name: RUNTM_INGRESS_CIDRS
              value: "${join(" ", ingress_cidrs)}"
          readinessProbe:
            tcpSocket: { port: http }
            periodSeconds: 10
          resources:
            requests: { cpu: 250m, memory: 256Mi }
          volumeMounts:
            - { name: config, mountPath: /etc/caddy }
      volumes:
        - name: config
          configMap:
            name: sandbox-router
---
# Reserved address (output by main.tf as the router IP), reachable only from
# Runtm's egress addresses. Local: the router sees the real source address.
apiVersion: v1
kind: Service
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
  labels:
    app: sandbox-router
spec:
  type: LoadBalancer
  loadBalancerIP: ${router_ip}
  externalTrafficPolicy: Local
  loadBalancerSourceRanges: ${jsonencode(ingress_cidrs)}
  selector:
    app: sandbox-router
  ports:
    - { name: http, port: 80, targetPort: http }
%{ else ~}
# Preview router, previews on your own domain: a regional GKE Gateway (TLS
# terminated with a Certificate Manager certificate) -> this router ->
# <sandbox>.sandboxes.svc:<port>. Runtm's preview proxy image in its customer
# mode (RUNTM_PROXY_MODE=customer, configured by the env below): it checks
# Runtm's signed preview token itself. Same namespace and label as the edge
# router: the one ingress source agent-sandbox's per-sandbox NetworkPolicy admits.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
  labels:
    app: sandbox-router
spec:
  replicas: 2
  selector:
    matchLabels:
      app: sandbox-router
  template:
    metadata:
      labels:
        app: sandbox-router
      annotations:
        cluster-autoscaler.kubernetes.io/safe-to-evict: "false"
    spec:
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app: sandbox-router
      containers:
        - name: caddy
          image: ${router_image}
          # A moving tag: every (re)start runs the current router image.
          imagePullPolicy: Always
          ports:
            - { name: http, containerPort: 8080 }
          env:
            # The image's config for customer clusters (the default is Runtm's hosted one).
            - { name: RUNTM_PROXY_MODE, value: customer }
            - { name: RUNTM_PREVIEW_DOMAIN, value: "${preview.domain}" }
            # Single quotes: the backslashes are literal (regex escapes, not YAML ones).
            - { name: RUNTM_PREVIEW_DOMAIN_RE, value: '${preview.domain_re}' }
            - { name: RUNTM_PREVIEW_JWKS_URL, value: "${preview.jwks_url}" }
            - { name: RUNTM_APP_ORIGIN, value: "${preview.app_origin}" }
            # The load balancer's proxies (proxy-only subnet): the only trusted proxies.
            - { name: RUNTM_PROXY_CIDRS, value: "${preview.proxy_cidr}" }
          readinessProbe:
            httpGet: { path: /__runtm/healthz, port: http }
            periodSeconds: 10
          resources:
            requests: { cpu: 250m, memory: 256Mi }
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: sandbox-router
---
apiVersion: v1
kind: Service
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
  labels:
    app: sandbox-router
spec:
  type: ClusterIP
  selector:
    app: sandbox-router
  ports:
    - { name: http, port: 80, targetPort: http }
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
spec:
  gatewayClassName: ${preview.gateway_class}
  addresses:
    - type: NamedAddress
      value: ${preview.address_name}
  listeners:
    - name: https
      protocol: HTTPS
      port: 443
      hostname: "*.${preview.domain}"
      tls:
        mode: Terminate
        options:
          networking.gke.io/cert-manager-certs: ${preview.cert_name}
      allowedRoutes:
        namespaces:
          from: Same
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
spec:
  parentRefs:
    - name: sandbox-router
  hostnames:
    - "*.${preview.domain}"
  rules:
    - backendRefs:
        - name: sandbox-router
          port: 80
---
# The router answers 200 only on this path (every other request needs a token).
apiVersion: networking.gke.io/v1
kind: HealthCheckPolicy
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
spec:
  default:
    config:
      type: HTTP
      httpHealthCheck:
        requestPath: /__runtm/healthz
  targetRef:
    group: ""
    kind: Service
    name: sandbox-router
---
# Long-lived dev-server connections (WebSocket HMR, SSE) outlast the 30 s default.
apiVersion: networking.gke.io/v1
kind: GCPBackendPolicy
metadata:
  name: sandbox-router
  namespace: agent-sandbox-system
spec:
  default:
    timeoutSec: 3600
%{ if preview.security_policy != null ~}
    securityPolicy: ${preview.security_policy}
%{ endif ~}
  targetRef:
    group: ""
    kind: Service
    name: sandbox-router
%{ endif ~}
%{ if length(egress_allowed_cidrs) > 0 ~}
---
# Private ranges sandboxes may reach (sandbox_egress_allowed_cidrs). Additive:
# agent-sandbox's per-sandbox NetworkPolicy blocks private ranges, and
# NetworkPolicies allow the union of their rules. Selects sandbox pods only
# (the label agent-sandbox sets), which that policy already isolates.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: runtm-egress-allowed
  namespace: sandboxes
spec:
  podSelector:
    matchExpressions:
      - { key: agents.x-k8s.io/sandbox-template-ref-hash, operator: Exists }
  policyTypes: [Egress]
  egress:
    - to:
%{ for cidr in egress_allowed_cidrs ~}
        - ipBlock: { cidr: "${cidr}" }
%{ endfor ~}
%{ endif ~}
