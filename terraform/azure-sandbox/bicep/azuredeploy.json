  "outputs": {
    "brokerClientId": {
      "type": "string",
      "metadata": {
        "description": "Paste into Runtm (Integrations -> Azure Sandboxes): client id of the broker identity."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', format('runtm-sandbox-{0}', variables('label'))), '2025-04-01').outputs.brokerClientId.value]"
    },
    "brokerPrincipalId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', format('runtm-sandbox-{0}', variables('label'))), '2025-04-01').outputs.brokerPrincipalId.value]"
    },
    "brokerIdentityId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', format('runtm-sandbox-{0}', variables('label'))), '2025-04-01').outputs.brokerIdentityId.value]"
    },
    "tenantId": {
      "type": "string",
      "value": "[tenant().tenantId]"
    },
    "subscriptionId": {
      "type": "string",
      "value": "[subscription().subscriptionId]"
    },
    "resourceGroup": {
      "type": "string",
      "value": "[variables('resourceGroupName')]"
    },
    "location": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "sandboxGroup": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', format('runtm-sandbox-{0}', variables('label'))), '2025-04-01').outputs.sandboxGroupName.value]"
    },
