        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "label": {
            "value": "[variables('label')]"
          },
          "googleSubject": {
            "value": "[parameters('googleSubject')]"
          },
          "googleIssuer": {
            "value": "[parameters('googleIssuer')]"
          },
          "audience": {
            "value": "[parameters('audience')]"
          },
          "storageAccountName": {
            "value": "[parameters('storageAccountName')]"
          },
          "registryName": {
            "value": "[parameters('registryName')]"
          },
          "sessionArtifactRetentionDays": {
            "value": "[parameters('sessionArtifactRetentionDays')]"
          },
          "templateVersionRetentionDays": {
            "value": "[parameters('templateVersionRetentionDays')]"
          },
          "storageSharedKeyAccess": {
            "value": "[parameters('storageSharedKeyAccess')]"
          },
          "createVnet": {
            "value": "[parameters('createVnet')]"
          },
          "vnetCidr": {
            "value": "[parameters('vnetCidr')]"
          },
          "subnetCidr": {
            "value": "[parameters('subnetCidr')]"
          },
          "tags": {
            "value": "[variables('allTags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "5085216543611188509"
            }
          },
          "parameters": {
            "label": {
              "type": "string",
              "metadata": {
                "description": "<suffix>-<slug> or <slug>: the per-organization part of every resource name (computed in main.bicep)."
              }
            },
            "googleSubject": {
              "type": "string",
              "metadata": {
                "description": "Numeric unique id of the organization's Runtm Google service account; the federated credential's subject."
              }
            },
            "googleIssuer": {
              "type": "string",
              "metadata": {
                "description": "Issuer of the tokens Runtm presents."
              }
            },
            "audience": {
              "type": "string",
              "metadata": {
                "description": "Audience of the Google token Runtm mints for this subscription."
              }
            },
            "storageAccountName": {
              "type": "string",
              "metadata": {
                "description": "Storage account name (3-24 lowercase alphanumerics)."
              }
            },
            "registryName": {
              "type": "string",
              "metadata": {
                "description": "Container registry name (5-50 alphanumerics)."
              }
            },
            "sessionArtifactRetentionDays": {
              "type": "int",
              "metadata": {
                "description": "Days to keep paused-session workspace layers (sessions/)."
              }
            },
            "templateVersionRetentionDays": {
              "type": "int",
              "metadata": {
                "description": "Days a superseded template golden version (templates/) is kept."
              }
            },
            "storageSharedKeyAccess": {
              "type": "bool",
              "metadata": {
                "description": "Allow Shared Key authorization on the storage account."
              }
            },
            "createVnet": {
              "type": "bool",
              "metadata": {
                "description": "Create a VNet with a delegated subnet and connect the sandbox group to it."
              }
            },
            "vnetCidr": {
              "type": "string",
              "metadata": {
                "description": "VNet address space."
              }
            },
            "subnetCidr": {
              "type": "string",
              "metadata": {
                "description": "Delegated subnet (inside vnetCidr) sandboxes attach to."
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Tags for every resource."
              }
            }
          },
          "variables": {
            "location": "[resourceGroup().location]",
            "brokerIdentityName": "[format('runtm-sandbox-broker-{0}', parameters('label'))]",
            "sandboxGroupName": "[format('rtm-{0}', parameters('label'))]",
            "vnetName": "[format('runtm-sandbox-egress-{0}', parameters('label'))]",
            "subnetName": "sandboxes",
            "vnetConnectionName": "default",
            "containerName": "layers",
            "federatedCredentialName": "google-runtm-org",
            "roleContributor": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]",
            "roleSandboxDataOwner": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'c24cf47c-5077-412d-a19c-45202126392c')]",
            "roleAcrPull": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
            "roleBlobContributor": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]"
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[variables('brokerIdentityName')]",
              "location": "[variables('location')]",
              "tags": "[union(parameters('tags'), createObject('runtm:component', 'broker-identity'))]"
            },
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
              "apiVersion": "2023-01-31",
              "name": "[format('{0}/{1}', variables('brokerIdentityName'), variables('federatedCredentialName'))]",
              "properties": {
                "issuer": "[parameters('googleIssuer')]",
                "subject": "[parameters('googleSubject')]",
                "audiences": [
                  "[parameters('audience')]"
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName'))]"
              ]
            },
            {
              "type": "Microsoft.App/sandboxGroups",
              "apiVersion": "2026-07-01",
              "name": "[variables('sandboxGroupName')]",
              "location": "[variables('location')]",
              "tags": "[union(parameters('tags'), createObject('runtm:component', 'sandbox-group'))]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')))]": {}
                }
              },
              "properties": {},
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName'))]"
              ]
            },
            {
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-07-01",
              "name": "[parameters('registryName')]",
              "location": "[variables('location')]",
              "sku": {
                "name": "Basic"
              },
              "tags": "[union(parameters('tags'), createObject('runtm:component', 'sandbox-images'))]",
              "properties": {
                "adminUserEnabled": false
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2024-01-01",
              "name": "[parameters('storageAccountName')]",
              "location": "[variables('location')]",
              "kind": "StorageV2",
              "sku": {
                "name": "Standard_LRS"
              },
              "tags": "[union(parameters('tags'), createObject('runtm:component', 'sandbox-artifacts'))]",
              "properties": {
                "minimumTlsVersion": "TLS1_2",
                "supportsHttpsTrafficOnly": true,
                "allowBlobPublicAccess": false,
                "allowSharedKeyAccess": "[parameters('storageSharedKeyAccess')]",
                "defaultToOAuthAuthentication": true,
                "accessTier": "Hot"
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices",
              "apiVersion": "2024-01-01",
              "name": "[format('{0}/{1}', parameters('storageAccountName'), 'default')]",
              "properties": {
                "isVersioningEnabled": true
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
              ]
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
              "apiVersion": "2024-01-01",
              "name": "[format('{0}/{1}/{2}', parameters('storageAccountName'), 'default', variables('containerName'))]",
              "properties": {
                "publicAccess": "None"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
              ]
            },
            {
              "type": "Microsoft.Storage/storageAccounts/managementPolicies",
              "apiVersion": "2024-01-01",
              "name": "[format('{0}/{1}', parameters('storageAccountName'), 'default')]",
              "properties": {
                "policy": {
                  "rules": [
                    {
                      "name": "expire-session-layers",
                      "enabled": true,
                      "type": "Lifecycle",
                      "definition": {
                        "filters": {
                          "blobTypes": [
                            "blockBlob"
                          ],
                          "prefixMatch": [
                            "[format('{0}/sessions/', variables('containerName'))]"
                          ]
                        },
                        "actions": {
                          "baseBlob": {
                            "delete": {
                              "daysAfterModificationGreaterThan": "[parameters('sessionArtifactRetentionDays')]"
                            }
                          },
                          "version": {
                            "delete": {
                              "daysAfterCreationGreaterThan": 1
                            }
                          }
                        }
                      }
                    },
                    {
                      "name": "retain-template-goldens",
                      "enabled": true,
                      "type": "Lifecycle",
                      "definition": {
                        "filters": {
                          "blobTypes": [
                            "blockBlob"
                          ],
                          "prefixMatch": [
                            "[format('{0}/templates/', variables('containerName'))]"
                          ]
                        },
                        "actions": {
                          "version": {
                            "delete": {
                              "daysAfterCreationGreaterThan": "[parameters('templateVersionRetentionDays')]"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', variables('containerName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/locks",
              "apiVersion": "2020-05-01",
              "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "name": "runtm-sandbox-layers-retain",
              "properties": {
                "level": "CanNotDelete",
                "notes": "Runtm sandbox workspace layers and template goldens. Remove this lock before deleting the storage account."
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), variables('roleContributor'))]",
              "properties": {
                "roleDefinitionId": "[variables('roleContributor')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.App/sandboxGroups', variables('sandboxGroupName'))]",
              "name": "[guid(resourceId('Microsoft.App/sandboxGroups', variables('sandboxGroupName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), variables('roleSandboxDataOwner'))]",
              "properties": {
                "roleDefinitionId": "[variables('roleSandboxDataOwner')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName'))]",
                "[resourceId('Microsoft.App/sandboxGroups', variables('sandboxGroupName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName'))]",
              "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), variables('roleAcrPull'))]",
              "properties": {
                "roleDefinitionId": "[variables('roleAcrPull')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName'))]",
                "[resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), variables('roleBlobContributor'))]",
              "properties": {
                "roleDefinitionId": "[variables('roleBlobContributor')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
              ]
            },
            {
              "condition": "[parameters('createVnet')]",
              "type": "Microsoft.Network/virtualNetworks",
              "apiVersion": "2024-05-01",
              "name": "[variables('vnetName')]",
              "location": "[variables('location')]",
              "tags": "[union(parameters('tags'), createObject('runtm:component', 'sandbox-vnet'))]",
              "properties": {
                "addressSpace": {
                  "addressPrefixes": [
                    "[parameters('vnetCidr')]"
                  ]
                },
                "subnets": [
                  {
                    "name": "[variables('subnetName')]",
                    "properties": {
                      "addressPrefix": "[parameters('subnetCidr')]",
                      "delegations": [
                        {
                          "name": "sandboxes",
                          "properties": {
                            "serviceName": "Microsoft.App/environments"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "condition": "[parameters('createVnet')]",
              "type": "Microsoft.App/sandboxGroups/vnetConnections",
              "apiVersion": "2026-07-01",
              "name": "[format('{0}/{1}', variables('sandboxGroupName'), variables('vnetConnectionName'))]",
              "properties": {
                "subnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName'))]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/sandboxGroups', variables('sandboxGroupName'))]",
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
              ]
            }
          ],
          "outputs": {
            "brokerClientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), '2023-01-31').clientId]"
            },
            "brokerPrincipalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName')), '2023-01-31').principalId]"
            },
            "brokerIdentityId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('brokerIdentityName'))]"
            },
            "sandboxGroupName": {
              "type": "string",
              "value": "[variables('sandboxGroupName')]"
            },
            "sandboxGroupId": {
              "type": "string",
              "value": "[resourceId('Microsoft.App/sandboxGroups', variables('sandboxGroupName'))]"
            },
            "acrLoginServer": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName')), '2023-07-01').loginServer]"
