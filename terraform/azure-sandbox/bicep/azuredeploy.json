            "storageAccount": {
              "type": "string",
              "value": "[parameters('storageAccountName')]"
            },
            "container": {
              "type": "string",
              "value": "[variables('containerName')]"
            },
            "vnetId": {
              "type": "string",
              "value": "[if(parameters('createVnet'), resourceId('Microsoft.Network/virtualNetworks', variables('vnetName')), '')]"
            },
            "subnetId": {
              "type": "string",
              "value": "[if(parameters('createVnet'), resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName')), '')]"
            },
            "vnetConnectionName": {
              "type": "string",
              "value": "[if(parameters('createVnet'), variables('vnetConnectionName'), '')]"
            }
          }
        }
      },
