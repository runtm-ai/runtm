# Runtm Production Self-Hosting Environment
# Copy to .env.prod and fill in your values.
#
# Usage:
#   cp infra/local.env.prod.example .env.prod
#   docker compose -f infra/docker-compose.prod.yml --env-file .env.prod up -d

# ============================================================================
# Required
# ============================================================================

# Managed Postgres (RDS, Cloud SQL, Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/runtm

# Managed Redis (ElastiCache, Memorystore, Upstash, etc.)
REDIS_URL=redis://your-redis-host:6379

# API secret -- generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNTM_API_SECRET=generate-a-strong-secret-at-least-32-chars

# Domain for HTTPS (Caddy will auto-provision a Let's Encrypt cert)
# Set to "localhost" for local testing with a self-signed cert.
RUNTM_DOMAIN=runtm.example.com

# ============================================================================
# Deploy Provider
# ============================================================================

# "fly"   -- Fly.io Machines (requires FLY_API_TOKEN)
# "local" -- Local Docker containers (dev only, not for production)
DEPLOY_PROVIDER=fly

# Fly.io (required when DEPLOY_PROVIDER=fly)
FLY_API_TOKEN=your-fly-personal-access-token
FLY_ORG=personal

# ============================================================================
# Optional
# ============================================================================

# Auth mode
AUTH_MODE=single_tenant

# Storage backend: "local" (Docker volume) or "s3" (Tigris, S3, MinIO)
ARTIFACT_STORAGE_BACKEND=local

# S3/Tigris (only when ARTIFACT_STORAGE_BACKEND=s3)
# BUCKET_NAME=runtm-artifacts
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_ACCESS_KEY_ID=tid_...
# AWS_SECRET_ACCESS_KEY=tsec_...

# Build strategy
USE_REMOTE_BUILDER=true

# Trusted proxies (Caddy runs inside the compose network)
# Default covers Docker bridge networks.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# Custom domain (optional -- maps deployments to your domain)
# RUNTM_BASE_DOMAIN=runtm.com
# DNS_PROVIDER=cloudflare
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ZONE_ID=...
