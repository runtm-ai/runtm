# Runtm Local Development Environment
# Used by ./.runtm/setup.local.sh. Values are local-only and safe placeholders.

# API auth
RUNTM_API_SECRET=dev-token-change-in-production
RUNTM_API_KEY=dev-token-change-in-production
AUTH_MODE=single_tenant
DEBUG=true

# Local service ports. setup.local.sh rewrites these per workspace.
RUNTM_API_BIND=127.0.0.1
RUNTM_API_PORT=8000
RUNTM_POSTGRES_PORT=5432
RUNTM_REDIS_PORT=6379
RUNTM_API_URL=http://127.0.0.1:8000

# Host-facing URLs for local Python processes.
DATABASE_URL=postgresql://runtm:runtm@127.0.0.1:5432/runtm
REDIS_URL=redis://127.0.0.1:6379

# Deployment provider settings.
# The placeholder lets the local stack boot without cloud credentials.
# Real deployments still require a Fly personal access token.
FLY_API_TOKEN=local-dev-placeholder
FLY_ORG=personal

# Storage
ARTIFACT_STORAGE_PATH=artifacts
ARTIFACT_STORAGE_BACKEND=local

# Build behavior
USE_REMOTE_BUILDER=true
